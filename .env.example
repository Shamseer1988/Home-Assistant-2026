# ============================================================
#  SIDRA Dashboard 2026 — environment configuration
#  Copy this file to ".env" and fill in your values.
# ============================================================

# ---- Home Assistant connection -----------------------------
# Base URL of your Home Assistant server (reachable from the LXC container).
# Use the LAN IP or hostname of the HA machine — NOT localhost, because the
# app runs in a separate Proxmox LXC container.
HA_BASE_URL=http://192.168.1.10:8123

# Optional explicit WebSocket URL. Leave blank to auto-derive from HA_BASE_URL
# (http -> ws, https -> wss, with /api/websocket appended).
HA_WS_URL=

# Long-Lived Access Token.
# Create one in Home Assistant: Profile -> Security -> Long-Lived Access Tokens.
HA_TOKEN=paste-your-long-lived-token-here

# Set to "false" if HA uses a self-signed HTTPS certificate.
HA_VERIFY_SSL=true

# ---- Backend (Flask) ---------------------------------------
# Use a long random string (32+ chars). Also signs JWTs unless JWT_SECRET_KEY set.
SECRET_KEY=change-me-to-a-long-random-string
PORT=5000
# Allowed browser origins for CORS / Socket.IO. Use the LXC host:port the
# frontend is served from, or "*" while developing.
CORS_ORIGINS=*

# ---- Database ----------------------------------------------
# SQLite on the mounted volume (persists across container rebuilds).
DATABASE_URL=sqlite:////data/sidra.db

# ---- Admin login -------------------------------------------
# Seeded on first boot if no users exist. CHANGE THESE before first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Set to true only when serving over HTTPS (Phase 7).
JWT_COOKIE_SECURE=false

# ---- Frontend (Next.js) ------------------------------------
# Public URL the BROWSER uses to reach the backend API + Socket.IO.
# This is baked into the frontend build, so set it to the LXC host IP:port.
PUBLIC_API_URL=http://192.168.1.20:5000
